{
  "name": "@excelat/react",
  "version": "0.1.0",
  "description": "High-performance, keyboard-first React spreadsheet and data grid with zero external dependencies",
  "author": "Excelat",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "logo.svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jp024556/excelat.git",
    "directory": "packages/react"
  },
  "homepage": "https://excelat.onstatpio.com",
  "bugs": {
    "url": "https://github.com/jp024556/excelat/issues"
  },
  "keywords": [
    "excel",
    "spreadsheet",
    "table",
    "data-grid",
    "datagrid",
    "react",
    "react-table",
    "virtualization",
    "grid",
    "statpio"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-dts": "^4.1.1",
    "vitest": "^2.0.5"
  }
}
